# Dedicated, opt-in CPU-only trainer. Not built by normal docker compose up.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1 \
    TOKENIZERS_PARALLELISM=false HF_HOME=/private/cache \
    HF_HUB_DISABLE_TELEMETRY=1
WORKDIR /src
COPY scripts/requirements-galancito-cpu.txt /tmp/cpu-deps.txt
RUN python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch==2.7.1" \
 && python -m pip install --no-cache-dir -r /tmp/cpu-deps.txt \
 && rm -f /tmp/cpu-deps.txt
COPY scripts/galant_cpu_lora_resources.py scripts/galant_cpu_lora_resources.py
COPY scripts/galancito_lora_progress.py scripts/galancito_lora_progress.py
COPY scripts/train_galancito_cpu_lora.py scripts/train_galancito_cpu_lora.py
COPY scripts/max_power_cpu_manager.py scripts/max_power_cpu_manager.py
COPY scripts/max_power_synthetic_lab.py scripts/max_power_synthetic_lab.py
COPY scripts/max_power_end_to_end_smoke.py scripts/max_power_end_to_end_smoke.py
COPY apps/backend/app/__init__.py apps/backend/app/__init__.py
COPY apps/backend/app/galancito_finetune_dataset.py apps/backend/app/galancito_finetune_dataset.py
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin trainer \
 && chmod -R a+rX /src
USER 10001:10001
ENTRYPOINT ["python", "/src/scripts/train_galancito_cpu_lora.py"]
CMD ["--preflight"]
