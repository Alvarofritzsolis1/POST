# Root CPU experiment; no application or production chatbot dependencies.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1 RAYON_NUM_THREADS=2 \
    TOKENIZERS_PARALLELISM=false HF_HOME=/private/cache HF_HUB_DISABLE_TELEMETRY=1 \
    PYTHONPATH=/src/apps/backend
WORKDIR /src
RUN --mount=type=secret,id=proxy_ca,required=false \
    if [ -s /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi \
 && python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch==2.7.1" \
 && python -m pip install --no-cache-dir "transformers==5.24.0" "peft==0.22.0" "accelerate==1.16.0" "bitsandbytes==0.49.2" "huggingface_hub==1.33.0" "safetensors==0.8.0" "tokenizers==0.23.3" "cryptography==48.0.1"
COPY scripts/galant_cpu_lora_resources.py scripts/probe_galancito_2b_cpu.py scripts/max_power_2b_manager.py scripts/galancito_2b_conversation_gate.py scripts/galancito_2b_approved.py /src/scripts/
COPY apps/backend/app/__init__.py apps/backend/app/max_power_2b_control.py apps/backend/app/galancito_finetune_dataset.py apps/backend/app/galancito_model_config.py /src/apps/backend/app/
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin trainer && chmod -R a+rX /src && mkdir -p /private/2b-probe /private/cache /2b-control && chown -R 10001:10001 /private /2b-control
USER 10001:10001
ENTRYPOINT ["timeout","--signal=TERM","--kill-after=30s","7200s","python","/src/scripts/probe_galancito_2b_cpu.py"]
