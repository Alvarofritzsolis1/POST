# Root CPU experiment; no application or production chatbot dependencies.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false HF_HOME=/private/cache HF_HUB_DISABLE_TELEMETRY=1
WORKDIR /src
RUN python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch==2.7.1" \
 && python -m pip install --no-cache-dir "transformers==5.24.0" "peft==0.22.0" "accelerate==1.16.0" "bitsandbytes==0.49.2" "huggingface_hub==1.33.0" "safetensors==0.8.0" "tokenizers==0.23.3"
COPY scripts/galant_cpu_lora_resources.py scripts/probe_galancito_4b_cpu.py scripts/max_power_4b_manager.py scripts/galancito_4b_conversation_gate.py /src/scripts/
COPY apps/backend/app/max_power_4b_control.py /src/scripts/max_power_4b_control.py
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin trainer && chmod -R a+rX /src && mkdir -p /private/4b-probe /private/cache /4b-control && chown -R 10001:10001 /private /4b-control
USER 10001:10001
ENTRYPOINT ["timeout","--signal=TERM","--kill-after=30s","7200s","python","/src/scripts/probe_galancito_4b_cpu.py"]
