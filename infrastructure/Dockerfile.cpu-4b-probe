# Optional 4B CPU experiment. Never installed into the GALANT API or 0.8B trainer.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false HF_HOME=/private/cache HF_HUB_DISABLE_TELEMETRY=1
WORKDIR /src
COPY scripts/requirements-galancito-cpu.txt /tmp/cpu-deps.txt
RUN python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch==2.7.1" \
 && python -m pip install --no-cache-dir -r /tmp/cpu-deps.txt "bitsandbytes==0.49.2" \
 && rm -f /tmp/cpu-deps.txt
COPY scripts/galant_cpu_lora_resources.py scripts/galant_cpu_lora_resources.py
COPY scripts/probe_galancito_4b_cpu.py scripts/probe_galancito_4b_cpu.py
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin trainer && chmod -R a+rX /src
USER 10001:10001
ENTRYPOINT ["timeout", "--signal=TERM", "--kill-after=30s", "7200s", "python", "/src/scripts/probe_galancito_4b_cpu.py"]
