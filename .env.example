FACEBOOK_MESSAGING_ENABLED=false
FACEBOOK_ORG_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_AI_ENABLED=false
FACEBOOK_AI_AUTO_REPLY_ENABLED=false
FACEBOOK_AI_AD_ENABLED=false
FACEBOOK_AI_MODEL=gpt-4.1-mini
# FACEBOOK_AI_API_KEY: solo credencial privada en VPS, nunca en GitHub.
