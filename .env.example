APP_SECRET=REEMPLAZAR_SECRETO
POSTGRES_PASSWORD=REEMPLAZAR_PASSWORD
OCR_LANGUAGE=spa+eng
OCR_SECONDARY=disabled
SECURE_COOKIES=false
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=50
PORT=18512
PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Facebook: habilitar solo tras comprobar credenciales y revisión.
FACEBOOK_MANUAL_TESTING_ENABLED=false
FACEBOOK_AUTOPUBLISH_ENABLED=false
FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_TOKEN: configurar PRIVADAMENTE en el VPS; nunca en GitHub.

# Inbox/IA Facebook: no activar sin webhook verificado y permisos de Meta.
FACEBOOK_MESSAGING_ENABLED=false
FACEBOOK_ORG_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_AI_ENABLED=false
# La respuesta automática usa FACEBOOK_AI_ENABLED; no requiere un segundo flag.
FACEBOOK_AI_AD_ENABLED=false
FACEBOOK_AI_MODEL=gpt-4.1-mini
# FACEBOOK_AI_API_KEY: solo credencial privada en VPS, nunca en GitHub.

# Galancito para uso autenticado dentro de GALANT y Red de Obras.
GALANCITO_AI_ENABLED=false
GALANCITO_AI_MODEL=gpt-4.1-mini
# GALANCITO_AI_API_KEY: privado en VPS, no en repositorio ni en chats.

# Centro de IA multi-proveedor (Gemini, Groq, NVIDIA y otros):
# Generar una clave Fernet y definirla solo en el VPS como variable de entorno:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# AI_CREDENTIAL_ENCRYPTION_KEY: jamás incluir su valor en GitHub ni cambiarlo sin plan de migración.
# Esta clave cifra credenciales de todas las organizaciones; debe respaldarse de forma segura.
# Sin clave de cifrado el panel se puede consultar, pero NO guardar API Keys.

# IA local GRATUITA: solo Messenger y asesor de Red de Obras.
# Dejar apagada hasta ejecutar scripts/setup-galancito-local.py en el VPS.
# Comparar con scripts/benchmark_galancito.py antes de cambiar estos límites.
GALANCITO_KEEP_ALIVE=2m
FACEBOOK_WORKER_POLL_SECONDS=1
GALANCITO_NUM_PREDICT=140
GALANCITO_NUM_CTX=2048
GALANCITO_NUM_THREAD=1
GALANCITO_TIMEOUT_SECONDS=8
GALANCITO_MEMORY_RESERVE_MB=1536
GALANCITO_LOCAL_AI_ENABLED=false
GALANCITO_AI_PROVIDER=ollama
FACEBOOK_AI_PROVIDER=ollama
# Qwen3 1.7B privado: nunca habilitar puertos de Ollama en el router/host.
